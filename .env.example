# Required for the AI analyst. Without it Stxck runs in demo mode (template answers).
ANTHROPIC_API_KEY=

# Sessions: set a long random string in production (otherwise one is generated into DATA_DIR).
SESSION_SECRET=
# Where user accounts are stored (users.json). Mount a persistent volume here in production.
DATA_DIR=./data

# Password-reset emails via Resend (optional; without these, reset links are logged to the server console).
RESEND_API_KEY=
MAIL_FROM="Stxck <no-reply@yourdomain.com>"

# STXCK_MODEL=claude-opus-5
# PORT=5173
